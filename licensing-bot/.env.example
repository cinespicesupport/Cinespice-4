# Copy to .env in licensing-bot; run/export-config load it automatically. Never put these in an APK.
BOT_TOKEN=replace_with_BotFather_token
BOT_USERNAME=your_access_bot
BOT_USER_ID=123456789
PAID_GROUP_ID=-1001234567890
ADMIN_IDS=123456789
CONTACT_URL=https://t.me/your_contact
# Optional separate support/chat invite. Defaults to CONTACT_URL when omitted. Bot-only, no app rebuild.
CHAT_GROUP_URL=https://t.me/your_chat_group
# JSON array of optional updates channels. Bot must be an administrator in each channel and paid group.
REQUIRED_CHANNELS='[{"id":-1009876543210,"title":"Cinespice Community","url":"https://t.me/your_channel"}]'
# Optional: forward new posts from one configured channel as in-app announcements.
# ANNOUNCEMENT_CHANNEL_ID=-1009876543210
SIGNING_KEY=state/signing-key.pem
DATABASE=state/bot.sqlite3
ACCESS_TTL_SECONDS=3600
